---
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props as Props
---

<svg
  viewBox="0 0 400 400"
  role="img"
  aria-hidden="true"
  class:list={['blob', className]}
>
  <defs>
    <linearGradient id="blobGradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--green-400)" />
      <stop offset="100%" stop-color="var(--lime-300)" />
    </linearGradient>
  </defs>
  <path
    fill="url(#blobGradient)"
    d="M320,64 C368,112 392,176 376,240 C360,304 304,368 232,376 C160,384 72,376 32,320 C-8,264 8,168 56,104 C104,40 176,24 232,32 C272,0 288,32 320,64 Z"
  />
</svg>

<style>
  .blob {
    position: absolute;
    z-index: -1;
    opacity: 0.5;
  }
</style>
