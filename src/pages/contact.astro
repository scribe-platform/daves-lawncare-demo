---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { url } from '../lib/base';
import { getCollection } from 'astro:content';

// The Turnstile site key lives in .scribe.yml, written there by
// `scribe site update --turnstile-key`. Read it at build time rather than
// hardcoding it, so rotating the key is a Scribe command plus a rebuild.
// Matched with a regex instead of a YAML parser to keep this site free of a
// dependency for one top-level scalar that Scribe itself writes.
// Failing the build beats shipping a contact form that silently 401s.
// Resolved from cwd (the repo root during a build), not import.meta.url —
// this frontmatter gets bundled into dist/, so a relative URL would look
// for the file next to the built chunk.
const scribeYml = readFileSync(resolve(process.cwd(), '.scribe.yml'), 'utf-8');
const turnstileSiteKey = scribeYml.match(/^turnstileSiteKey:\s*['"]?([^'"\s]+)['"]?\s*$/m)?.[1];
if (!turnstileSiteKey) {
  throw new Error('No turnstileSiteKey in .scribe.yml — the contact form cannot be built without it.');
}

const allPackages = await getCollection('packages');
const packages = allPackages
  .filter((p) => p.data.isActive)
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);

// GitHub Actions resolves an unset repo variable to an empty string rather
// than leaving it undefined, so `??` alone wouldn't fall back here.
const apiBase = import.meta.env.PUBLIC_SCRIBE_API_URL || 'https://scribe.weaverdigital.io';
const submissionUrl = `${apiBase}/api/submissions?site=daves-lawncare-demo&collection=inquiries`;
---

<Base
  title="Get Started"
  description="Request a free quote from Dave's Lawn Care. Tell us about your lawn and we'll get back to you."
>
  <section class="section container get-started">
    <span class="eyebrow">Get started</span>
    <h1>Tell us about your lawn</h1>
    <p class="intro">
      Fill out the form below and we'll follow up to schedule your free
      quote. No commitment required.
    </p>

    <form id="inquiry-form" class="card inquiry-form" data-endpoint={submissionUrl} data-scribe-retry>
      <label>
        Name<span class="required">*</span>
        <input type="text" name="name" required />
      </label>

      <label>
        Email<span class="required">*</span>
        <input type="email" name="email" required />
      </label>

      <label>
        Phone
        <input type="tel" name="phone" />
      </label>

      <label>
        Service address / area
        <input type="text" name="serviceAddress" placeholder="e.g. 123 Main St or your neighborhood" />
      </label>

      <label>
        Which package are you interested in?
        <select name="packageInterest">
          <option value="">Not sure yet</option>
          {packages.map((pkg) => <option value={pkg.id}>{pkg.data.title}</option>)}
        </select>
      </label>

      <label>
        Anything else we should know?
        <textarea name="message" rows="4"></textarea>
      </label>

      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>

      <button type="submit" class="btn btn-primary">Request my free quote</button>

      <p id="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById('inquiry-form');
  const status = document.getElementById('form-status');
  const submitButton = form.querySelector('button[type="submit"]');

  // RFC 0024 — a submission the server never received is kept here and replayed
  // on the next page load, so a visitor is never told their request sent when it
  // did not. The <form> declares this with data-scribe-retry; the two belong
  // together and must not separate.
  const STORAGE_KEY = 'scribe_pending_submission_daves-lawncare-demo_inquiries';

  const readPending = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  };
  const savePending = (payload) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
    } catch {
      // localStorage unavailable (private browsing, quota). The status message
      // is already honest about the failure; there is nothing more to persist.
    }
  };
  const clearPending = () => {
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      // see savePending
    }
  };

  const GENERIC = 'Sorry, something went wrong submitting the form. Please try again or email us directly.';
  const UNREACHABLE = "We couldn't send that yet — it's saved and will retry.";

  function say(message, kind) {
    status.textContent = message;
    status.className = kind ?? '';
    status.hidden = false;
  }

  async function send(body) {
    const res = await fetch(form.dataset.endpoint, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (res.ok) return;
    // A non-2xx means the server answered and said why, which is a different
    // thing from never reaching it. `answered` picks whose copy the visitor
    // reads; `retryable` decides whether a later attempt could plausibly land.
    const err = await res.json().catch(() => ({}));
    const error = new Error((err.error ?? '').trim() || GENERIC);
    error.answered = true;
    error.retryable = res.status >= 500;
    throw error;
  }

  // Pre-select a package if ?package=slug is in the URL
  const params = new URLSearchParams(window.location.search);
  const preselectedPackage = params.get('package');
  if (preselectedPackage) {
    const select = form.elements.namedItem('packageInterest');
    if (select) select.value = preselectedPackage;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submitButton.disabled = true;
    say('Sending...');

    const formData = new FormData(form);
    // Turnstile injects this hidden input into the form once its challenge
    // resolves. In managed mode that's usually automatic and instant, but a
    // fast submit can beat it.
    const turnstileToken = formData.get('cf-turnstile-response');
    if (!turnstileToken) {
      say('Just a moment — the verification check is still running. Please try again.', 'error');
      submitButton.disabled = false;
      return;
    }

    const body = {
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone') || undefined,
      serviceAddress: formData.get('serviceAddress') || undefined,
      packageInterest: formData.get('packageInterest') || undefined,
      message: formData.get('message') || undefined,
      'cf-turnstile-response': turnstileToken,
    };

    try {
      await send(body);
      clearPending();
      form.reset();
      form.hidden = true;
      say("Thanks! We've received your request and will be in touch soon.", 'success');
    } catch (err) {
      // Never claim a success the server didn't give, and never paper over its
      // message with ours.
      if (err.answered) {
        if (err.retryable) savePending(body);
        say(err.message, 'error');
      } else {
        savePending(body);
        say(UNREACHABLE, 'error');
      }
      submitButton.disabled = false;
      // A Turnstile token is single-use — without a reset, a retry would
      // send the spent token and fail verification no matter what.
      window.turnstile?.reset();
    }
  });

  // Replay on the next page load, which is what makes the queue worth having.
  (async function retryPending() {
    const pending = readPending();
    if (!pending) return;
    try {
      await send(pending);
      clearPending();
      form.reset();
      form.hidden = true;
      say("Thanks! We've received your request and will be in touch soon.", 'success');
    } catch (err) {
      // Replaying a rejection (a stale Turnstile token, a validation error) on
      // every page load would loop forever, so drop it and show what the server
      // said. Anything else stays queued for next time.
      if (err.answered && !err.retryable) {
        clearPending();
        say(err.message, 'error');
      }
    }
  })();
</script>

<style>
  .get-started h1 {
    margin-bottom: 8px;
  }

  .intro {
    max-width: 560px;
    margin-bottom: 32px;
    color: var(--ink-soft);
  }

  .inquiry-form {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .inquiry-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 600;
  }

  .required {
    color: #c0392b;
  }

  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--sky-tint);
  }

  .inquiry-form button {
    align-self: flex-start;
  }

  #form-status {
    font-weight: 600;
    min-height: 1.2em;
  }

  #form-status.success {
    color: var(--green-700);
  }

  #form-status.error {
    color: #c0392b;
  }
</style>
