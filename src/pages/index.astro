---
import Base from '../layouts/Base.astro';
import SunGrassHero from '../components/graphics/SunGrassHero.astro';
import WaveDivider from '../components/graphics/WaveDivider.astro';
import MowerIcon from '../components/graphics/MowerIcon.astro';
import LeafIcon from '../components/graphics/LeafIcon.astro';
import SprinklerIcon from '../components/graphics/SprinklerIcon.astro';
import { url } from '../lib/base';
import { formatPrice } from '../lib/format';
import { getCollection } from 'astro:content';

const allPackages = await getCollection('packages');
const packages = allPackages
  .filter((p) => p.data.isActive)
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder)
  .slice(0, 3);
---

<Base
  title="Home"
  description="Dave's Lawn Care offers weekly mowing, fertilization, and full lawn care packages for homeowners who want a lawn that looks after itself."
>
  <section class="hero">
    <div class="hero-graphic">
      <SunGrassHero />
    </div>
    <div class="container hero-content">
      <span class="eyebrow">Locally owned &amp; operated</span>
      <h1>A lawn you'll actually be proud of.</h1>
      <p class="hero-sub">
        Dave's Lawn Care keeps yards across [Your City] mowed, fed, and
        looking sharp &mdash; so you don't have to think about it.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url('/contact')}>Get a Free Quote</a>
        <a class="btn btn-secondary" href={url('/packages')}>Browse Packages</a>
      </div>
    </div>
  </section>

  <WaveDivider fill="var(--paper)" />

  <section class="section container why-us">
    <h2>Why homeowners choose us</h2>
    <div class="card-grid">
      <div class="card feature">
        <MowerIcon />
        <h3>Reliable weekly service</h3>
        <p>Same crew, same schedule, every week &mdash; no surprises.</p>
      </div>
      <div class="card feature">
        <LeafIcon />
        <h3>Healthy, green results</h3>
        <p>Fertilization and weed control tailored to your lawn's needs.</p>
      </div>
      <div class="card feature">
        <SprinklerIcon />
        <h3>Full-service options</h3>
        <p>From a simple mow to complete seasonal lawn care, we scale with you.</p>
      </div>
    </div>
  </section>

  <WaveDivider fill="var(--sky-tint)" flip />

  <section class="section container packages-teaser">
    <h2>Popular packages</h2>
    <div class="card-grid">
      {
        packages.map((pkg) => (
          <div class="card">
            <h3>{pkg.data.title}</h3>
            <p class="price">
              {formatPrice(pkg.data.monthlyPrice)} <small>/ month</small>
            </p>
            <a class="btn btn-secondary" href={url('/packages')}>
              View details
            </a>
          </div>
        ))
      }
    </div>
    <p class="see-all">
      <a href={url('/packages')}>See all packages &rarr;</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--sky-tint), var(--paper));
    overflow: hidden;
    padding-top: 72px;
    min-height: 480px;
    display: flex;
    align-items: center;
  }

  .hero-graphic {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    padding-bottom: 96px;
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .why-us h2,
  .packages-teaser h2 {
    text-align: center;
    margin-bottom: 32px;
  }

  .feature {
    text-align: left;
  }

  .feature h3 {
    margin-top: 16px;
  }

  .see-all {
    text-align: center;
    margin-top: 24px;
    font-weight: 600;
  }
</style>
